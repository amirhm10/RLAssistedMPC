# Keep the tracked directory placeholders, but ignore generated result runs.
Polymer/Results/*
!Polymer/Results/.gitkeep

Distillation/Results/*
!Distillation/Results/.gitkeep

# Shared generated result folders.
Result/
Results/

# Other generated result or temporary run folders.
VanDeVusse/Results/*
.tmp_*/

# Timestamped experiment bundles under Data are generated outputs.
Data/**/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9]/

# Python cache artifacts.
__pycache__/
*.py[cod]

# Generated report figures and analysis assets should stay local.
report/figures/*
!report/figures/.gitkeep
